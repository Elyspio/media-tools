{
	"name": "app-vite",
	"version": "1.0.0",
	"description": "An Electron application with React and TypeScript",
	"main": "./out/main/index.js",
	"author": "example.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --cache .",
		"typecheck:node": "tsc --noEmit -p config/tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p config/tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite -c config/electron.vite.config.ts dev",
		"build": "npm run typecheck && electron-vite -c config/electron.vite.config.ts build",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@chrissantamaria/electron-devtools-installer": "^4.0.0-fork.1",
		"@ctrl/qbittorrent": "^9.11.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.5",
		"@mui/material": "^7.3.5",
		"@nestjs/common": "^11.1.9",
		"@reduxjs/toolkit": "^2.10.1",
		"@tsed/logger": "^8.0.4",
		"dayjs": "^1.11.19",
		"electron-updater": "^6.3.9",
		"fast-xml-parser": "^5.3.2",
		"inversify": "^7.10.4",
		"nest-winston": "^1.10.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-redux": "^9.2.0",
		"react-router": "^7.9.6",
		"react-syntax-highlighter": "^16.1.0",
		"react-toastify": "^11.0.5",
		"redux-logger": "^3.0.6",
		"reflect-metadata": "^0.2.2",
		"systeminformation": "^5.27.11",
		"winston": "^3.18.3"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.0.0",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^3.1.18",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.6",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/redux-logger": "^3.0.13",
		"@vitejs/plugin-react": "^5.1.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"electron": "^39.2.3",
		"electron-builder": "^26.0.12",
		"electron-vite": "^4.0.1",
		"mime-types": "^3.0.2",
		"typescript": "^5.9.3",
		"vite": "^7.2.4"
	}
}
