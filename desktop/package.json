{
	"name": "elytools",
	"version": "1.9.0",
	"description": "An Electron application with React and TypeScript",
	"packageManager": "pnpm@10.32.1",
	"main": "./out/main/index.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elyspio/elytools.git"
	},
	"author": "jona.guich69@gmail.com",
	"scripts": {
		"clean": "tsx ./scripts/clean/clean-release.ts",
		"clean:bundle": "tsx ./scripts/clean/clean-bundle.ts",
		"format": "prettier --write .",
		"lint": "eslint --cache . --fix",
		"typecheck": "tsc --watch --noEmit",
		"start": "electron-vite preview",
		"dev": "electron-vite -c config/electron.vite.config.ts dev -w",
		"prebuild": "rimraf out dist",
		"build": "electron-vite -c config/electron.vite.config.ts build",
		"postbuild": "electron-builder --config config/electron-builder.yml -w",
		"build:bundle": "tsx ./scripts/build/build-bundle.ts",
		"build:release:win": "tsx ./scripts/build/build-release-win.ts",
		"build:release:linux": "tsx ./scripts/build/build-release-linux.ts",
		"build:release:linux:container": "tsx ./scripts/build/build-release-linux-container.ts",
		"publish:release": "tsx ./scripts/publish/publish-release.ts",
		"release": "tsc && concurrently -n windows,linux \"pnpm run build:release:win\" \"pnpm run build:release:linux\" && pnpm run publish:release",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@chrissantamaria/electron-devtools-installer": "4.0.0-fork.1",
		"@ctrl/qbittorrent": "^9.11.2",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@fontsource/ibm-plex-mono": "^5.2.7",
		"@fontsource/ibm-plex-sans": "^5.2.8",
		"@mui/icons-material": "^7.3.9",
		"@mui/material": "^7.3.9",
		"@mui/system": "^7.3.9",
		"@mui/x-data-grid": "^8.28.1",
		"@nestjs/common": "^11.1.17",
		"@reduxjs/toolkit": "^2.11.2",
		"@tsed/logger": "^8.0.5",
		"@vitejs/plugin-react": "^6.0.1",
		"class-transformer": "^0.5.1",
		"class-validator": "0.15.1",
		"dayjs": "^1.11.20",
		"electron-updater": "^6.8.3",
		"fast-xml-parser": "^5.5.9",
		"inversify": "^8.1.0",
		"nest-winston": "^1.10.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-redux": "^9.2.0",
		"react-router": "^7.13.2",
		"react-syntax-highlighter": "^16.1.1",
		"react-toastify": "^11.0.5",
		"redux": "5.0.1",
		"redux-logger": "^3.0.6",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"systeminformation": "^5.31.5",
		"vite-plugin-svgr": "^5.0.0",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-decorators": "^7.29.0",
		"@babel/plugin-transform-class-properties": "^7.28.6",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^4.0.4",
		"@types/node": "^25.5.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/redux-logger": "^3.0.13",
		"babel-plugin-transform-typescript-metadata": "^0.4.0",
		"concurrently": "^9.2.1",
		"electron": "^41.1.0",
		"electron-builder": "^26.8.1",
		"electron-vite": "^5.0.0",
		"rimraf": "^6.1.3",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.5"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"electron",
			"electron-winstaller",
			"esbuild"
		]
	}
}
