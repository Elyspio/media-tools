{
	"name": "elytools",
	"version": "1.4.0",
	"description": "An Electron application with React and TypeScript",
	"main": "./out/main/index.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/Elyspio/media-tools.git"
	},
	"author": "jona.guich69@gmail.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --cache . --fix",
		"typecheck": "tsc --watch --noEmit",
		"start": "electron-vite preview",
		"dev": "electron-vite -c config/electron.vite.config.ts dev -w",
		"prebuild": "rimraf out dist",
		"build": "electron-vite -c config/electron.vite.config.ts build",
		"postbuild": "electron-builder --config config/electron-builder.yml -w",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@chrissantamaria/electron-devtools-installer": "^4.0.0-fork.1",
		"@ctrl/qbittorrent": "^9.11.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.7",
		"@mui/material": "^7.3.7",
		"@mui/x-data-grid": "^8.25.0",
		"@nestjs/common": "^11.1.12",
		"@reduxjs/toolkit": "^2.11.2",
		"@tsed/logger": "^8.0.4",
		"dayjs": "^1.11.19",
		"electron-updater": "^6.7.3",
		"fast-xml-parser": "^5.3.3",
		"inversify": "^7.11.0",
		"nest-winston": "^1.10.2",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-redux": "^9.2.0",
		"react-router": "^7.12.0",
		"react-syntax-highlighter": "^16.1.0",
		"react-toastify": "^11.0.5",
		"redux-logger": "^3.0.6",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"systeminformation": "^5.30.5",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@babel/plugin-proposal-class-properties": "^7.18.6",
		"@babel/plugin-proposal-decorators": "^7.28.6",
		"@babel/plugin-transform-class-properties": "^7.28.6",
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^3.1.25",
		"@types/node": "^25.0.9",
		"@types/react": "^19.2.8",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/redux-logger": "^3.0.13",
		"babel-plugin-transform-typescript-metadata": "^0.4.0",
		"electron": "^40.0.0",
		"electron-builder": "^26.4.0",
		"electron-vite": "^5.0.0",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"rimraf": "^6.1.3"
	}
}
