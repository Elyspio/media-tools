{
	"name": "app-vite",
	"version": "1.0.0",
	"description": "An Electron application with React and TypeScript",
	"main": "./out/main/index.js",
	"author": "example.com",
	"homepage": "https://electron-vite.org",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint --cache . --fix",
		"typecheck": "tsc --watch --noEmit",
		"start": "electron-vite preview",
		"dev": "electron-vite -c config/electron.vite.config.ts dev",
		"build": "npm run typecheck && electron-vite -c config/electron.vite.config.ts build",
		"postinstall": "electron-builder install-app-deps"
	},
	"dependencies": {
		"@chrissantamaria/electron-devtools-installer": "^4.0.0-fork.1",
		"@ctrl/qbittorrent": "^9.11.0",
		"@electron-toolkit/preload": "^3.0.2",
		"@electron-toolkit/utils": "^4.0.0",
		"@emotion/react": "^11.14.0",
		"@emotion/styled": "^11.14.1",
		"@mui/icons-material": "^7.3.6",
		"@mui/material": "^7.3.6",
		"@mui/x-data-grid": "^8.23.0",
		"@nestjs/common": "^11.1.10",
		"@reduxjs/toolkit": "^2.11.2",
		"@tsed/logger": "^8.0.4",
		"dayjs": "^1.11.19",
		"electron-updater": "^6.3.9",
		"fast-xml-parser": "^5.3.3",
		"inversify": "^7.10.8",
		"nest-winston": "^1.10.2",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"react-redux": "^9.2.0",
		"react-router": "^7.11.0",
		"react-syntax-highlighter": "^16.1.0",
		"react-toastify": "^11.0.5",
		"redux-logger": "^3.0.6",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"systeminformation": "^5.28.2",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@electron-toolkit/tsconfig": "^2.0.0",
		"@elyspio/vite-eslint-config": "^3.1.24",
		"@types/node": "^25.0.3",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/react-syntax-highlighter": "^15.5.13",
		"@types/redux-logger": "^3.0.13",
		"electron": "^39.2.7",
